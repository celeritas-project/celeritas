{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": ".base",
      "hidden": true,
      "inherits": ["full", ".nobuiltin"],
      "binaryDir": "${sourceDir}/../build/celeritas-${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "ON"
        },
        "CELERITAS_BUILD_DOCS": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_CUDA": {
          "type": "BOOL",
          "value": "ON"
        },
        "CELERITAS_USE_HIP": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_OpenMP": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_MPI": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_PNG": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_ROOT": {
          "type": "BOOL",
          "value": "ON"
        },
        "CELERITAS_USE_DD4hep": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_LArSoft": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -pedantic -Werror -Wno-stringop-overread -fdiagnostics-color -ffile-prefix-map=${sourceDir}/..=/work",
        "CMAKE_INSTALL_RPATH": "$ORIGIN:$ORIGIN/../lib",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CUDA_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_EXTENSIONS": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../install/celeritas-${presetName}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": {
          "type": "BOOL",
          "value": "ON"
        },
        "CELERITAS_USE_VecGeom": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CMAKE_CUDA_ARCHITECTURES": "70;80;90;120"
      }
    },
    {
      "name": ".orange",
      "hidden": true,
      "cacheVariables": {
        "CELERITAS_USE_VecGeom": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-z,defs",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,-z,defs"
      }
    },
    {
      "name": "release-orange-cuda",
      "displayName": "Build with full optimizations (ORANGE, CUDA)",
      "inherits": [".orange", ".base", ".release"],
      "cacheVariables": {
        "CELERITAS_USE_OpenMP": {
          "type": "BOOL",
          "value": "ON"
        },
        "CELERITAS_OPENMP": "track"
      }
    },
    {
      "name": "release-orange-hip",
      "displayName": "Build with full optimizations (ORANGE, HIP)",
      "inherits": [".orange", ".base", ".release"],
      "cacheVariables": {
        "CELERITAS_USE_OpenMP": {
          "type": "BOOL",
          "value": "ON"
        },
        "CELERITAS_OPENMP": "track",
        "CELERITAS_USE_CUDA": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_HIP": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_HIP_ARCHITECTURES": "gfx906;gfx908;gfx942",
        "CMAKE_HIP_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "release-orange-nodevice",
      "displayName": "Build with full optimizations (ORANGE, no device, no OpenMP)",
      "inherits": [".orange", ".base", ".release"],
      "cacheVariables": {
        "CELERITAS_USE_OpenMP": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_CUDA": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_HIP": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "reldeb-orange",
      "displayName": "Build with optimizations, but enable host debugging (ORANGE)",
      "inherits": [".orange", ".base", ".reldeb"]
    },
    {
      "name": "debug-orange",
      "displayName": "Build without optimization, enabling full host debugging (ORANGE)",
      "inherits": [".orange", ".base", ".debug"],
      "cacheVariables": {
        "CELERITAS_DEVICE_DEBUG": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "release-orange-cuda-float",
      "displayName": "Build with full optimizations, single precision (ORANGE, CUDA)",
      "inherits": ["release-orange-cuda"],
      "cacheVariables": {
        "CELERITAS_REAL_TYPE": "float"
      }
    },
    {
      "name": "release-orange-hip-float",
      "displayName": "Build with full optimizations, single precision (ORANGE, HIP)",
      "inherits": ["release-orange-hip"],
      "cacheVariables": {
        "CELERITAS_REAL_TYPE": "float"
      }
    },
    {
      "name": "debug-orange-float",
      "displayName": "Build without optimization, single precision (ORANGE, no device, no OpenMP)",
      "inherits": ["debug-orange"],
      "cacheVariables": {
        "CELERITAS_REAL_TYPE": "float",
        "CELERITAS_USE_CUDA": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_HIP": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CELERITAS_USE_OpenMP": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": ".base",
      "configurePreset": ".base",
      "jobs": 48,
      "nativeToolOptions": ["-k0"]
    },
    {
      "name": "release-orange-cuda",
      "configurePreset": "release-orange-cuda",
      "inherits": ".base"
    },
    {
      "name": "release-orange-hip",
      "configurePreset": "release-orange-hip",
      "inherits": ".base"
    },
    {
      "name": "release-orange-nodevice",
      "configurePreset": "release-orange-nodevice",
      "inherits": ".base"
    },
    {
      "name": "reldeb-orange",
      "configurePreset": "reldeb-orange",
      "inherits": ".base"
    },
    {
      "name": "debug-orange",
      "configurePreset": "debug-orange",
      "inherits": ".base"
    },
    {
      "name": "release-orange-cuda-float",
      "configurePreset": "release-orange-cuda-float",
      "inherits": ".base"
    },
    {
      "name": "release-orange-hip-float",
      "configurePreset": "release-orange-hip-float",
      "inherits": ".base"
    },
    {
      "name": "debug-orange-float",
      "configurePreset": "debug-orange-float",
      "inherits": ".base"
    }
  ],
  "testPresets": [
    {
      "name": ".base",
      "configurePreset": ".base",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "jobs": 8
      }
    },
    {
      "name": "release-orange-cuda",
      "configurePreset": "release-orange-cuda",
      "inherits": ".base"
    },
    {
      "name": "release-orange-hip",
      "configurePreset": "release-orange-hip",
      "inherits": ".base"
    },
    {
      "name": "reldeb-orange",
      "configurePreset": "reldeb-orange",
      "inherits": ".base"
    },
    {
      "name": "debug-orange",
      "configurePreset": "debug-orange",
      "inherits": ".base"
    },
    {
      "name": "release-orange-cuda-float",
      "configurePreset": "release-orange-cuda-float",
      "inherits": ".base"
    },
    {
      "name": "release-orange-hip-float",
      "configurePreset": "release-orange-hip-float",
      "inherits": ".base"
    },
    {
      "name": "debug-orange-float",
      "configurePreset": "debug-orange-float",
      "inherits": ".base"
    }
  ],
  "include": ["../../CMakePresets.json"]
}
