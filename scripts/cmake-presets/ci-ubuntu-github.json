{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "CONFIG: ubuntu options for clang/gcc",
      "inherits": ["default"],
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "cacheVariables": {
        "CELERITAS_BUILD_TESTS": { "type": "BOOL", "value": "ON" },
        "CELERITAS_BUILD_DOCS": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_covfie": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_CLI11": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_G4VG": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_GTest": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_nlohmann_json": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_DEBUG": { "type": "BOOL", "value": "ON" },
        "CELERITAS_TEST_VERBOSE": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_covfie": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_CUDA": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_DD4hep": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_HepMC3": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_HIP": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_LarSoft": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_MPI": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_OpenMP": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_Perfetto": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_PNG": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_VecGeom": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_HOSTNAME": "ubuntu-github",
        "CELERITAS_TEST_XML": "$env{GITHUB_WORKSPACE}/test-output/google/",
        "BUILD_SHARED_LIBS": { "type": "BOOL", "value": "ON" },
        "CMAKE_BUILD_TYPE": { "type": "STRING", "value": "Release" },
        "CMAKE_CXX_STANDARD": "$env{CXXSTD}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_EXTENSIONS": { "type": "BOOL", "value": "OFF" },
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -pedantic -Werror -Wno-error=deprecated-declarations",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install"
      }
    },
    {
      "name": "tool-spack",
      "inherits": ["base", ".spack-base"],
      "displayName": "CONFIG: use full spack toolchain",
      "cacheVariables": {
        "CELERITAS_USE_covfie": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_Geant4": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_HepMC3": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_ROOT": null
      }
    },
    {
      "name": "tool-system",
      "inherits": ["base"],
      "displayName": "TOOLCHAIN: build with apt-get dependencies",
      "cacheVariables": {
        "BUILD_TESTING": { "type": "BOOL", "value": "ON" },
        "CELERITAS_BUILTIN_CLI11": { "type": "BOOL", "value": "ON" },
        "CELERITAS_BUILTIN_GTest": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_covfie": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_Geant4": { "type": "BOOL", "value": "OFF" }
      }
    },
    {
      "name": ".vecgeom",
      "hidden": true,
      "description": "CONFIG: options to enable VecGeom on Ubuntu",
      "cacheVariables": {
        "CELERITAS_USE_VecGeom": { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": ".nogtest",
      "hidden": true,
      "description": "CONFIG: disable googletest",
      "cacheVariables": {
        "CELERITAS_BUILD_TESTS": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_GTest": { "type": "BOOL", "value": "OFF" }
      }
    },
    {
      "name": ".doc",
      "hidden": true,
      "inherits": [".nogtest"],
      "displayName": "CONFIG: build only documentation",
      "cacheVariables": {
        "BUILD_TESTING": { "type": "BOOL", "value": "OFF" },
        "CMAKE_CXX_STANDARD": null,
        "CELERITAS_BUILD_APPS": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILD_DOCS": { "type": "BOOL", "value": "ON" },
        "CELERITAS_DEBUG": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_DOXYGEN_BUILD_TESTS": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_covfie": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_PNG": { "type": "BOOL", "value": "OFF" }
      }
    },
    {
      "name": "doc",
      "inherits": [".doc", "tool-system"]
    },
    {
      "name": "doc-check",
      "inherits": [".doc", "tool-system"],
      "displayName": "FINAL: build docs for testing as part of a pull request",
      "cacheVariables": {
        "DOXYGEN_WARN_AS_ERROR": "YES",
        "DOXYGEN_HAVE_DOT": "NO",
        "DOXYGEN_QUIET": "NO",
        "CELERITAS_SPHINX_ARGS": "-W;--keep-going"
      }
    },
    {
      "name": "doc-publish",
      "inherits": [".doc", "tool-system"],
      "displayName": "FINAL: build docs after new develop is pushed",
      "cacheVariables": {
        "DOXYGEN_WARN_AS_ERROR": "NO"
      }
    },
    {
      "name": "fast",
      "inherits": ["tool-system"],
      "displayName": "FINAL: fast build using apt-get",
      "cacheVariables": {
        "CELERITAS_USE_HepMC3": { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": "ultralite",
      "inherits": [".nogtest", "tool-system"],
      "displayName": "FINAL: ultralite build with only app tests",
      "cacheVariables": {
        "CELERITAS_DEBUG": { "type": "BOOL", "value": "OFF" }
      }
    },
    {
      "name": "vecgeom-tidy",
      "description": "FINAL: VecGeom and clang-tidy checks",
      "inherits": [".nogtest", ".vecgeom", "tool-spack"],
      "cacheVariables": {
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "OFF" },
        "CMAKE_CXX_SCAN_FOR_MODULES": { "type": "BOOL", "value": "OFF" },
        "CMAKE_EXPORT_COMPILE_COMMANDS": { "type": "BOOL", "value": "ON" },
        "CMAKE_CXX_CLANG_TIDY": { "type": "PATH", "value": "$env{CLANG_TIDY}" }
      }
    },
    {
      "name": "vecgeom-clhep",
      "description": "FINAL: VecGeom and CLHEP units",
      "inherits": [".vecgeom", "tool-spack"],
      "cacheVariables": {
        "CELERITAS_UNITS": "CLHEP"
      }
    },
    {
      "name": "vecgeom",
      "description": "FINAL: release, assertions, VecGeom",
      "inherits": [".vecgeom", "tool-spack"]
    },
    {
      "name": "vecgeom-codecov",
      "description": "FINAL: VecGeom with code coverage (no debug assertions)",
      "inherits": [".vecgeom", ".gcov", "tool-spack"],
      "cacheVariables": {
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "ON" },
        "CMAKE_CXX_FLAGS": null
      }
    },
    {
      "name": "vecgeom2",
      "description": "FINAL: release, assertions, VecGeom 2",
      "inherits": [".vecgeom", "tool-spack"]
    },
    {
      "name": "orange-static",
      "description": "FINAL: static libraries and perfetto, no tests",
      "inherits": [".nogtest", "tool-spack"],
      "cacheVariables": {
        "CELERITAS_DEBUG": { "type": "BOOL", "value": "OFF" },
        "BUILD_SHARED_LIBS": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_Perfetto": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILD_DOCS": { "type": "BOOL", "value": "OFF" }
      }
    },
    {
      "name": "geant4",
      "description": "FINAL: Geant4 geometry",
      "inherits": ["tool-spack"],
      "cacheVariables": {
        "CELERITAS_CORE_GEO": "Geant4",
        "CELERITAS_UNITS": "CLHEP"
      }
    },
    {
      "name": "orange-ancient",
      "description": "FINAL: minimal GCC8 build for SCALE integration",
      "inherits": ["tool-spack"],
      "cacheVariables": {
        "CELERITAS_DEBUG": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILD_APPS": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_Geant4": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_HepMC3": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_PNG": { "type": "BOOL", "value": "OFF" }
      }
    },
    {
      "name": "orange-asanlite",
      "description": "FINAL: address sanitizer flags and debug symbols",
      "inherits": ["tool-spack"],
      "cacheVariables": {
        "CELERITAS_DEBUG": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_Geant4": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_HepMC3": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "OFF" },
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CELERITAS_C_FLAGS": {
          "type": "STRING",
          "value": "-fsanitize=address"
        },
        "CELERITAS_CXX_FLAGS": {
          "type": "STRING",
          "value": "-fsanitize=address"
        },
        "CELERITAS_LINK_FLAGS": {
          "type": "STRING",
          "value": "-fsanitize=address"
        },
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -fno-omit-frame-pointer"
      }
    },
    {
      "name": "orange-float",
      "description": "FINAL: single-precision arithmetic",
      "inherits": ["tool-spack"],
      "cacheVariables": {
        "CELERITAS_REAL_TYPE": "float"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "base",
      "configurePreset": "base",
      "nativeToolOptions": ["-k0"],
      "verbose": true
    },
    {
      "name": "spack",
      "configurePreset": "tool-spack",
      "inherits": "base"
    },
    {
      "name": "doc",
      "inherits": "base"
    },
    {
      "name": "fast",
      "inherits": "base"
    },
    {
      "name": "ultralite",
      "inherits": "base"
    }
  ],
  "testPresets": [
    {
      "name": ".base",
      "configurePreset": "base",
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "jobs": 4
      },
      "output": {
        "maxFailedTestOutputSize": 1048576,
        "maxPassedTestOutputSize": 2048,
        "outputOnFailure": true
      }
    },
    {
      "name": ".unit",
      "configurePreset": "base",
      "execution": {
        "timeout": 15
      },
      "filter": {
        "exclude": {
          "label": "app"
        }
      }
    },
    {
      "name": ".app",
      "configurePreset": "base",
      "execution": {
        "timeout": 60
      },
      "filter": {
        "include": {
          "label": "app"
        }
      },
      "output": {
        "outputJUnitFile": "$env{GITHUB_WORKSPACE}/test-output/ctest/app.xml"
      }
    },
    {
      "name": "spack-unit",
      "configurePreset": "tool-spack",
      "inherits": [".unit", ".base"]
    },
    {
      "name": "spack-app",
      "configurePreset": "tool-spack",
      "inherits": [".app", ".base"]
    },
    {
      "name": "spack-codecov-unit",
      "inherits": ["spack-unit"],
      "execution": {
        "timeout": 60
      }
    },
    {
      "name": "spack-codecov-app",
      "inherits": ["spack-app"],
      "execution": {
        "timeout": 60
      }
    },
    {
      "name": "fast-unit",
      "configurePreset": "fast",
      "inherits": [".unit", ".base"]
    },
    {
      "name": "fast-app",
      "configurePreset": "fast",
      "inherits": [".app", ".base"]
    },
    {
      "name": "ultralite",
      "configurePreset": "ultralite",
      "inherits": ".base",
      "execution": {
        "timeout": 30
      },
      "output": {
        "outputJUnitFile": "$env{GITHUB_WORKSPACE}/test-output/ctest/all.xml"
      }
    }
  ]
}
