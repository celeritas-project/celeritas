{
  "version": 4,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": ".ccache",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER_LAUNCHER": "/opt/homebrew/bin/ccache",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror -Wno-error=deprecated -pedantic -fdiagnostics-color=always -fpull-requestefix-map=${sourceDir}/=./"
      }
    },
    {
      "name": ".base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": { "type": "BOOL", "value": "ON" },
        "CELERITAS_ENABLE_TESTING": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_CUDA": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_DD4hep": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_Geant4": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_LArSoft": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_HIP": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_MPI": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_OpenMP": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_PNG": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_VecGeom": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILD_TESTS": { "type": "BOOL", "value": "ON" },
        "CMAKE_C_COMPILER_LAUNCHER": null,
        "CMAKE_CXX_COMPILER_LAUNCHER": null,
        "CMAKE_EXPORT_COMPILE_COMMANDS": { "type": "BOOL", "value": "ON" },
        "CMAKE_OSX_DEPLOYMENT_TARGET": { "type": "STRING", "value": "27" },
        "CMAKE_CXX_STANDARD": { "type": "STRING", "value": "20" },
        "CMAKE_CXX_EXTENSIONS": { "type": "BOOL", "value": "OFF" },
        "CMAKE_FIND_FRAMEWORK": { "type": "STRING", "value": "LAST" },
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install-${presetName}",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -fno-inline -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror -Wno-error=deprecated -pedantic -fdiagnostics-color=always"
      }
    },
    {
      "name": ".spackbase",
      "hidden": true,
      "generator": "Ninja",
      "inherits": [".base", ".nobuiltin"],
      "environment": {
        "CMAKE_PREFIX_PATH": "$env{SPACK_ROOT}/var/spack/environments/celeritas/.spack-env/view"
      },
      "cacheVariables": {
        "CELERITAS_USE_covfie": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_HepMC3": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_Geant4": { "type": "BOOL", "value": "ON" },
        "CELERITAS_USE_PNG": { "type": "BOOL", "value": "ON" },
        "CELERITAS_BUILD_TESTS": { "type": "BOOL", "value": "ON" },
        "CELERITAS_BUILTIN_CLI11": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_G4VG": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_nlohmann_json": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_BUILTIN_GTest": { "type": "BOOL", "value": "OFF" }
      }
    },
    {
      "name": "base",
      "displayName": "challenger: basic debug ORANGE build",
      "inherits": [".ccache", ".spackbase", ".debug", "default"],
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "ON" },
        "CELERITAS_BUILD_DOCS": { "type": "BOOL", "value": "ON" },
        "CELERITAS_PYTHONPATH": "/Users/seth/Code/py-breathe:/Users/seth/Code/py-sphinxcontrib-bibtex/src",
        "CELERITAS_PYTHONWARNINGS": "ignore:::urllib3,ignore:::breathe.project,ignore::UserWarning:pybtex.plugin",
        "CELERITAS_SPHINX_ARGS": "-W;--keep-going",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
        "DOXYGEN_WARN_AS_ERROR": "YES"
      }
    },
    {
      "name": "vecgeom",
      "displayName": "challenger: With vecgeom",
      "inherits": [".ccache", ".spackbase", ".debug", "default"],
      "cacheVariables": {
        "CELERITAS_USE_VecGeom": { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": "release-vecgeom",
      "displayName": "challenger: With vecgeom, g4 in optimized mode",
      "inherits": [".ccache", ".spackbase", ".release", "vecgeom"],
      "cacheVariables": {
        "CELERITAS_USE_HepMC3": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_VecGeom": { "type": "BOOL", "value": "ON" },
        "CELERITAS_BUILD_TESTS": { "type": "BOOL", "value": "OFF" }
      }
    },
    {
      "name": "float",
      "displayName": "challenger: Single-precision arithmetic",
      "inherits": [".spackbase", ".debug", "default"],
      "cacheVariables": {
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_REAL_TYPE": "float"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "base",
      "configurePreset": "base",
      "jobs": 8,
      "nativeToolOptions": ["-k0"]
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "configurePreset": "base",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "jobs": 8
      }
    }
  ]
}
