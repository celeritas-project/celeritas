//! \file corecel/Config.cc
//! \brief Celeritas config definition.
//---------------------------------------------------------------------------//
// clang-format off
#include "corecel/Config.hh"
// clang-format on

#include <string>
#include <unordered_map>

namespace celeritas
{
namespace cmake
{
//---------------------------------------------------------------------------//

// clang-format off
@CELERITAS_CMAKE_STRINGS_DEF@
// clang-format on

//---------------------------------------------------------------------------//
}  // namespace cmake

namespace
{
//---------------------------------------------------------------------------//

std::unordered_map<std::string, char const*> const& versions()
{
    static constexpr char package_disabled[] = "";
    static constexpr char undefined_version[] = "";
    static MapStrCstr result = {
        // clang-format off
@CELERITAS_CMAKE_VERSIONS_INIT@
        // clang-format on
    };
    return result;
}

//---------------------------------------------------------------------------//
}  // namespace

char const* package_version_cstring(char const* package)
{
    auto result = versions.find(package);
    if (result == versions.end())
        return nullptr;

    return result->second;
}

//---------------------------------------------------------------------------//
}  // namespace celeritas
