//! \file corecel/Config.cc
//! \brief Celeritas config definition.
//---------------------------------------------------------------------------//
// clang-format off
#include "corecel/Config.hh"
// clang-format on

#include <string>
#include <unordered_map>

namespace celeritas
{
namespace config
{
namespace
{
//---------------------------------------------------------------------------//
[[maybe_unused]] static constexpr char package_disabled[] = "";
[[maybe_unused]] static constexpr char package_undefined[] = "";

auto const& version_map()
{
    static std::unordered_map<std::string, char const*> const result = {
        // clang-format off
@CELERITAS_CMAKE_VERSIONS_INIT@
        // clang-format on
    };
    return result;
}

//---------------------------------------------------------------------------//
}  // namespace

// clang-format off
@CELERITAS_CMAKE_STRINGS_DEF@
;  // clang-format on

// Get a package version
char const* package_version_cstring(char const* package)
{
    auto const& versions = version_map();
    auto result = versions.find(package);
    if (result == versions.end())
        return nullptr;

    return result->second;
}

//---------------------------------------------------------------------------//
}  // namespace config
}  // namespace celeritas
