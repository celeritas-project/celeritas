//---------------------------------------------------------------------------//
// Tool configuration file for the LarCelerStandalone tool
//---------------------------------------------------------------------------//

BEGIN_PROLOG

LarCelerStandalone:
{
    tool_type: LarCelerStandalone

    // Celeritas output filename
    output_file: "celeritas-output.json"

    // Accumulate elapsed time in actions
    action_times: true

    // RNG seed
    seed: 0
}

END_PROLOG
