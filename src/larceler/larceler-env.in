#!/bin/sh
#-------------------------------- -*- sh -*- ---------------------------------#
# Copyright Celeritas contributors: see top-level COPYRIGHT file for details
# SPDX-License-Identifier: (Apache-2.0 OR MIT)
#-----------------------------------------------------------------------------#
# Print environment variables that should be exported to set up Celeritas with
# LArSoft.
#
# Usage:
#   eval $(larceler-env)        # bash/zsh
#   eval `larceler-env`         # sh
#   eval `larceler-env -c`      # csh/tcsh
#-----------------------------------------------------------------------------#

# Detect shell and define _prepend_var(varname value)
if [ "${1}" = "-c" ]; then
  # csh style
  _set_var() {
    printf "setenv %s \"%s\";\n" "$1" "$2"
  }
  _prepend_var() {
    printf "setenv %s %s:\"\${%s}\";\n" "$1" "$2" "$1"
  }
else
  # sh style
  _set_var() {
    printf "export %s=\"%s\";\n" "$1" "$2"
  }
  _prepend_var() {
    printf "export %s=\"%s:\${%s}\";\n" "$1" "$2" "$1"
  }
fi

prefix="@CELER_INSTALL_PREFIX@"
use_openmp=@CELER_USE_OPENMP@

# Limit OpenMP threads to the Slurm allocation, if any. Diagnostics go to
# stderr since stdout is evaluated by the shell.
if [ "${use_openmp}" = "1" ] && [ -z "${OMP_NUM_THREADS}" ]; then
  if [ "${1}" = "-c" ]; then
    echo "warning: OMP_NUM_THREADS is not set and Slurm detection is not" \
         "implemented for csh/tcsh: set it manually to avoid" \
         "oversubscribing CPUs" >&2
  else
    # Prefer the per-task count (srun/sbatch --cpus-per-task) over the
    # per-node count
    _slurm_cpus="${SLURM_CPUS_PER_TASK:-${SLURM_CPUS_ON_NODE}}"
    if [ -n "${_slurm_cpus}" ]; then
      echo "Setting OMP_NUM_THREADS=${_slurm_cpus} from Slurm allocation" >&2
      _set_var "OMP_NUM_THREADS" "${_slurm_cpus}"
    fi
  fi
fi

_prepend_var "CMAKE_PREFIX_PATH" "${prefix}"
_set_var "CELERITAS_DIR" "${prefix}"
_prepend_var "@CELER_LDVAR@" "${prefix}/@CMAKE_INSTALL_LIBDIR@"
_prepend_var "CET_PLUGIN_PATH" "${prefix}/@CMAKE_INSTALL_LIBDIR@"
_prepend_var "FHICL_FILE_PATH" "${prefix}/@CELERITAS_INSTALL_FHICLDIR@"
printf "printf \"Loaded Celeritas at %%s\\\\n\" \"${prefix}\" >&2\n"
