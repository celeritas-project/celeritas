//---------------------------------------------------------------------------//
// Tool configuration file for the PDFullSimCeler tool
//---------------------------------------------------------------------------//

BEGIN_PROLOG

PDFullSimCeler:
{
    module_type: PDFullSimCeler
    SimulationLabel:         "IonAndScint"

    // Celeritas output filename
    output_file: "celeritas-output.json"

    // Accumulate elapsed time in actions
    action_times: true

    // RNG seed
    seed: 0
}

END_PROLOG
