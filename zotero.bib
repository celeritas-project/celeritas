@inproceedings{neaseGeometricTemplatesImproved2014,
  title = {Geometric {{Templates}} for {{Improved Tracking Performance}} in {{Monte Carlo Codes}}},
  booktitle = {{{SNA}} + {{MC}} 2013 - {{Joint International Conference}} on {{Supercomputing}} in {{Nuclear Applications}} + {{Monte Carlo}}},
  author = {Nease, Brian R. and Millman, David L. and Griesheimer, David P. and Gill, Daniel F.},
