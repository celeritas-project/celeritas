  author = {Creaner, Ois{\'i}n and Blyth, Simon and Eriksen, Sam and Gerhardt, Lisa and Monzani, Maria Elena and Riffard, Quentin},
  editor = {Biscarat, C. and Campana, S. and Hegner, B. and Roiser, S. and Rovelli, C.I. and Stewart, G.A.},
