@article{apostolakisDetectorSimulationChallenges2022,
  title = {Detector {{Simulation Challenges}} for {{Future Accelerator Experiments}}},
  author = {Apostolakis, John and Bandieramonte, Marilena and Banerjee, Sunanda and Bartosik, Nazar and Corti, Gloria and Cosmo, Gabriele and Elvira, V. Daniel and Evans, Thomas and Gheata, Andrei and Pagan Griso, Simone and Ivantchenko, Vladimir and Jones, Christopher and Klute, Markus and Leggett, Charles and Morgan, Ben and Novak, Tadej and Pedro, Kevin and Paganetti, Harald},
