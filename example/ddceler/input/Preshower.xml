<lccdd>

  <info name="Preshower"
	title="Simple preshower detector with absorber and detection layers"
	author="Modified"
	url="http://www.cern.ch/lhcb"
	status="development"
	version="1.0">
    <comment>Simple two-layer preshower detector</comment>
  </info>

  <includes>
    <gdmlFile  ref="${DD4hepINSTALL}/DDDetectors/compact/elements.xml"/>
    <gdmlFile  ref="${DD4hepINSTALL}/DDDetectors/compact/materials.xml"/>
  </includes>

  <properties>
    <!-- ScintPS (optical polystyrene scintillator) refractive index vs photon energy -->
    <matrix name="RINDEX__ScintPS" coldim="2" values="
      2.00*eV 1.58
      2.50*eV 1.58
      2.75*eV 1.58
      3.00*eV 1.59
      3.50*eV 1.60
      4.00*eV 1.62
    "/>
    <!-- ScintPS bulk absorption length vs photon energy -->
    <matrix name="ABSLENGTH__ScintPS" coldim="2" values="
      2.00*eV 160.0*cm
      2.50*eV 160.0*cm
      2.75*eV 160.0*cm
      3.00*eV  80.0*cm
      3.50*eV  20.0*cm
      4.00*eV   1.0*cm
    "/>
    <!-- ScintPS scintillation emission spectrum -->
    <matrix name="SCINTILLATIONCOMPONENT1__ScintPS" coldim="2" values="
      2.75*eV 0.00
      2.95*eV 0.10
      3.00*eV 0.50
      3.05*eV 1.00
      3.10*eV 0.50
      3.20*eV 0.10
      3.50*eV 0.00
    "/>
  </properties>

  <materials>
    <!-- Optical scintillating polystyrene - renamed to avoid conflict with
         the non-optical Polystyrene already defined in DD4hep's materials.xml -->
    <material name="ScintPS">
      <D type="density" unit="g/cm3" value="1.032"/>
      <composite n="19" ref="C"/>
      <composite n="21" ref="H"/>
      <property name="RINDEX"               ref="RINDEX__ScintPS"/>
      <property name="ABSLENGTH"            ref="ABSLENGTH__ScintPS"/>
      <property name="SCINTILLATIONCOMPONENT1" ref="SCINTILLATIONCOMPONENT1__ScintPS"/>
      <constant name="SCINTILLATIONYIELD"   value="10000.0/MeV"/>
      <constant name="RESOLUTIONSCALE"      value="1.0"/>
      <constant name="SCINTILLATIONTIMECONSTANT1" value="2.4*ns"/>
      <constant name="SCINTILLATIONYIELD1"  value="1.0"/>
    </material>
  </materials>

  <define>
    <constant name="world_size" value="30*m"/>
    <constant name="world_x" value="world_size"/>
    <constant name="world_y" value="world_size"/>
    <constant name="world_z" value="world_size"/>
  </define>

  <display>
    <vis name="Invisible" showDaughters="false" visible="false"/>
    <vis name="InvisibleWithChildren" showDaughters="true" visible="false"/>
    <vis name="VisibleRed"  r="1.0" g="0.0" b="0.0" showDaughters="true" visible="true"/>
    <vis name="VisibleBlue" r="0.0" g="0.0" b="1.0" showDaughters="false" visible="true"/>
    <vis name="VisibleGreen" alpha="1.0" r="0.0" g="1.0" b="0.0" drawingStyle="solid" lineStyle="solid" showDaughters="true" visible="true"/>
    <vis name="VisibleYellow" alpha="1.0" r="1.0" g="1.0" b="0.0" drawingStyle="solid" lineStyle="solid" showDaughters="true" visible="true"/>
  </display>

  <limits>
    <limitset name="PreshowerLimitSet">
      <limit name="step_length_max" particles="*" value="5.0" unit="mm" />
    </limitset>
  </limits>

  <regions>
    <region name="PreshowerRegion" eunit="MeV" lunit="mm" cut="0.001" threshold="0.001">
      <limitsetref name="PreshowerLimitSet"/>
    </region>
  </regions>

  <detectors>
    <!-- Absorber layer - Lead, passive -->
    <detector id="1" name="AbsorberLayer" type="DD4hep_BoxSegment" vis="VisibleYellow" region="PreshowerRegion" limits="PreshowerLimitSet">
      <material name="Lead"/>
      <box      x="100*cm" y="100*cm" z="1*cm"/>
      <position x="0"      y="0"      z="150*cm"/>
      <rotation x="0"     y="0"      z="0"/>
    </detector>

    <!-- Detection layer - Scintillator, sensitive -->
    <detector id="2" name="DetectionLayer" type="DD4hep_BoxSegment" readout="PreshowerHits" vis="VisibleGreen" sensitive="true" region="PreshowerRegion" limits="PreshowerLimitSet">
      <material name="ScintPS"/>
      <sensitive type="calorimeter"/>
      <box      x="60*cm" y="60*cm" z="2.5*cm"/>
      <position x="0"     y="0"     z="151.75*cm"/>
      <rotation x="0"     y="0"     z="0"/>
    </detector>
  </detectors>

  <readouts>
    <readout name="PreshowerHits">
      <segmentation type="CartesianGridXY" grid_size_x="5*mm" grid_size_y="5*mm"/>
      <id>system:8,x:24:-12,y:-12</id>
    </readout>
  </readouts>

  <fields>
    <field name="ConstantField" type="ConstantField" field="magnetic">
      <strength x="0" y="0" z="5.0*tesla"/>
    </field>
  </fields>

</lccdd>
