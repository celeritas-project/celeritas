//---------------------------------------------------------------------------//
// Job execution for Geant4 and IonAndScint only for DUNE 1x2x6 geometry
//---------------------------------------------------------------------------//
#include "dune10kt_ionandscint.fcl"

services: {
    @table::services
    @table::dunefd_1x2x6_simulation_services
}

# Override detector geometry for consistency
# This GDML still has "PD" as the type in all arapuca volumes:
# <auxiliary auxtype="PD" auxvalue="PhotonDetector"/>
# This avoids setting the arapucas as SDs for the IonAndScint simulation.
services.Geometry.GDML: "dune10kt_v6_refactored_1x2x6-optical-nosd.gdml"
services.AuxDetGeometry.GDML: "dune10kt_v6_refactored_1x2x6-optical-nosd.gdml"
services.LArG4Detector.gdmlFileName_: "dune10kt_v6_refactored_1x2x6-optical-nosd.gdml"
